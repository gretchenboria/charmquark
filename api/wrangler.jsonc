{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charmquark-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // D1 — relational state. Create with:
  //   wrangler d1 create charmquark
  // then paste the returned database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "charmquark",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../db/migrations"
    }
  ],

  // R2 — recordings, instruction files, exported reports.
  //   wrangler r2 bucket create charmquark-vault
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "charmquark-vault" }
  ],

  // KV — hot fleet status cache (last-seen robot telemetry snapshots).
  //   wrangler kv namespace create FLEET_STATUS
  "kv_namespaces": [
    { "binding": "FLEET_STATUS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],

  "vars": {
    "ENVIRONMENT": "development"
  },

  // Bind the API to charmquark.app/api/* at the edge once the zone is on this
  // account. This is what makes the web Worker's dev-only rewrite unnecessary in
  // production: browser -> charmquark.app/api/* -> this Worker, one hop.
  // Uncomment after `wrangler d1 create` and DNS are done:
  // "routes": [{ "pattern": "charmquark.app/api/*", "zone_name": "charmquark.app" }]

  "env": {
    "production": {
      "vars": { "ENVIRONMENT": "production" }
      // Production disables the /dev/seed/* endpoints (see routes/dev.ts).
    }
  }
}
