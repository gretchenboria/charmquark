# --- Authentication ------------------------------------------------------
# Leave FIREBASE_PROJECT_ID unset locally to use the development header shim
# (the e2e suite relies on it). Set it to test real Firebase sign-in locally.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Emails that may self-provision as FLEET_LEAD on first sign-in.
# BOOTSTRAP_ADMIN_EMAILS=you@example.com

# Seals integration keys at rest. Any random value locally: openssl rand -base64 32
INTEGRATION_KEY_SECRET=replace-with-random-base64

# Charmy (in-app assistant).
# GEMINI_API_KEY=

# --- Stripe --------------------------------------------------------------
# Local-only Stripe credentials for `wrangler dev`. Copy to `.dev.vars` and fill
# in your TEST-mode values; `.dev.vars` is gitignored and must never be committed.
# In production these are Worker secrets, not vars:
#   wrangler secret put STRIPE_SECRET_KEY
#   wrangler secret put STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `stripe listen --forward-to http://127.0.0.1:8787/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe returns the buyer. Defaults to the request's Origin.
APP_ORIGIN=http://127.0.0.1:3000

# Roboflow annotation handoff. In production this is a Worker secret:
#   wrangler secret put ROBOFLOW_API_KEY
# Get a key from https://app.roboflow.com/account/api — see docs/ROBOFLOW.md.
ROBOFLOW_API_KEY=rf_xxx
# Optional: your workspace url slug, used for the lineage record and the
# project proxy (GET /api/roboflow/projects/:project).
ROBOFLOW_WORKSPACE=my-workspace
