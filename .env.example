# CharmQuark — copy to .env and fill in. .env is gitignored.
# Create a token at: https://dash.cloudflare.com/profile/api-tokens
# Scopes needed: Workers Scripts:Edit, D1:Edit, Workers KV:Edit, Workers R2:Edit, Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Stripe (metered run credits) ---------------------------------------
# NOT read from this file at runtime: the Worker reads them from its own
# secret store. Listed here so the required names are discoverable.
#   cd api
#   wrangler secret put STRIPE_SECRET_KEY       # sk_live_… / sk_test_…
#   wrangler secret put STRIPE_WEBHOOK_SECRET   # whsec_… from the webhook endpoint
# For `wrangler dev`, copy api/.dev.vars.example to api/.dev.vars (gitignored).
# See docs/BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
